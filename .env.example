# Admin password: /analytics and GET /api/admin/inbox/health (Sauron)
ADMIN_PASSWORD=changeme

# Public origin; builds /m/<token> links and registers the Telegram webhook
# (only when it starts with https://)
PUBLIC_BASE_URL=https://drose.io

# Umami analytics (injected at render time; leave UMAMI_ENABLED unset locally)
UMAMI_WEBSITE_ID=33e9b5a0-5fbf-474c-9d60-9bee34d577bd
UMAMI_SCRIPT_SRC=https://analytics.drose.io/script.js
UMAMI_DOMAINS=drose.io
UMAMI_TAG=prod
UMAMI_ENABLED=true
# /analytics dashboard reads the Umami API with these
UMAMI_API_URL=
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=
ANALYTICS_COLLECTOR_URL=
ANALYTICS_COLLECTOR_TOKEN=

# Pepper, the visitor agent. Each channel switches off when its vars are unset.
# Model (also used by the sprite's page-load quip)
OPENAI_API_KEY=
# optional, default gpt-5.2
PEPPER_MODEL=
# Email: SES sends and receives pepper@agents.drose.io
PEPPER_SES_ACCESS_KEY_ID=
PEPPER_SES_SECRET_ACCESS_KEY=
# optional, default "Pepper <pepper@agents.drose.io>"
PEPPER_MAIL_FROM=
# inbound mail arrives from this SNS topic
PEPPER_SNS_TOPIC_ARN=
# Shared secret for both webhooks: Telegram's secret-token header and the
# path segment of /api/pepper/email/<secret>
PEPPER_WEBHOOK_SECRET=
# Telegram: David's "Pepper's Desk" group (Topics on) and his user id
PEPPER_TELEGRAM_BOT_TOKEN=
PEPPER_TELEGRAM_BOT_USERNAME=
PEPPER_TELEGRAM_DESK_CHAT_ID=
PEPPER_TELEGRAM_DAVID_USER_ID=
