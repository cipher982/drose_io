# Twilio Configuration (optional)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_MESSAGING_SID=your_messaging_sid_here
TWILIO_TO_PHONE=+1234567890

# ntfy Configuration (optional)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=your_unique_topic_here

# Admin password for replying to threads
ADMIN_PASSWORD=changeme

# Umami Analytics
UMAMI_WEBSITE_ID=33e9b5a0-5fbf-474c-9d60-9bee34d577bd
UMAMI_SCRIPT_SRC=https://analytics.drose.io/script.js
UMAMI_DOMAINS=drose.io
UMAMI_TAG=prod
UMAMI_ENABLED=true

# OpenAI Configuration (for Pepper LLM thoughts)
OPENAI_API_KEY=sk-your-api-key-here

# Visitor reply emails (optional SES — continue link works without this)
VISITOR_MAIL_FROM=noreply@drose.io
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
PUBLIC_BASE_URL=https://drose.io

# Pepper, the visitor agent (all optional; each piece switches off when unset)
# Outbound email as pepper@drose.io via SES; replies come back through the
# swarmlet.com mail edge into an R2 bucket this server polls.
PEPPER_SES_ACCESS_KEY_ID=
PEPPER_SES_SECRET_ACCESS_KEY=
PEPPER_R2_ACCESS_KEY_ID=
PEPPER_R2_SECRET_ACCESS_KEY=
PEPPER_R2_ENDPOINT=
PEPPER_R2_BUCKET=pepper-mail-spool
# Telegram desk: David's private group with Topics, one topic per relayed visitor
PEPPER_TELEGRAM_BOT_TOKEN=
PEPPER_TELEGRAM_BOT_USERNAME=
PEPPER_TELEGRAM_DESK_CHAT_ID=
PEPPER_TELEGRAM_DAVID_USER_ID=
PEPPER_TELEGRAM_WEBHOOK_SECRET=
PEPPER_TELEGRAM_WEBHOOK_URL=https://drose.io/api/pepper/telegram
